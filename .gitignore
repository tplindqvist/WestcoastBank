<span style="-webkit-font-smoothing:antialiased">
  <img alt="Newsweek" src="https://assets.toptal.io/images?url=https%3A%2F%2Fbs-uploads.toptal.io%2Fblackfish-uploads%2Fcomponents%2Fcompany_logo%2F10976513%2Fimage%2Foriginal%2Fnewsweekl-46e8d219827c1468c3e2cadb6c715f4b.svg" loading="lazy" decoding="async" style="height:24px;width:auto;display:inline-block;vertical-align:middle;margin-right:4px"/>

  <span class="text-desktop">
    <span style="font-weight:600">Newsweek</span>
    Ranks Toptal
  </span>
